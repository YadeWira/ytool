# ── Salida del compilador FPC ────────────────────────────────────────────────
.fpcout/
.fpcout_dbg/
/build-x86/
*.o
*.O
*.ppu
*.compiled
*.or
link*.res

# ── Binario principal (se compila; ver README "Building") ────────────────────
/ytool
/ytool.exe
ytool_base
ytool-base
ytool-x86

# ── Plugins y dependencias externas construidas localmente ───────────────────
# Todas se regeneran con contrib/build-plugins-*.sh y contrib/build-native-*.sh
*.dll
*.so
*.so.*
# srep no esta en el repo (THIRD_PARTY.md); quien lo use deja su binario en la raiz.
/srep
/srep64
/srep.exe
/srep-x86.exe
# osrep (omega-srep, MIT) para -ddo: quien lo use deja su binario en la raiz.
# Antes: restos del pin de omega-srep, ya no se construyen pero pueden seguir en un
# arbol de trabajo viejo.
/osrep
/osrep64
/osrep.exe
/osrep-x86.exe

# ── Checkouts de terceros descargados por los build scripts ──────────────────
# contrib/pin-repo.sh los clona aqui; nunca se versionan (580 MB con todo).
contrib/.csrc/
# temporales de srep (future-LZ relee su entrada y usa un archivo de trabajo)
srep-data.tmp
*.tmp

# ── Material de prueba grande o privado ─────────────────────────────────────
testdata/
test-files*.tar
/regression-failures/

# ── Archivos de trabajo de agentes/IA (no forman parte del proyecto) ────────
CONEXION-IA.md
CONEXION-IA-W7.md
credenciales.md
handoff.md
message-from-*.md
xtool_*.7z
*.tar

# ── Editor / SO ─────────────────────────────────────────────────────────────
*~
.DS_Store
